
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-5.2",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md",
    "docs/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "cmake --build*": "allow",
      "make*": "allow",
      "ctest*": "allow"
    }
  },
  "disabled_providers": [
    "openai",
    "google"
  ],
  "provider": {
    "opencode": {
      "options": {
        "timeout": 60000,
        "chunkTimeout": 15000
      }
    }
  }
}
