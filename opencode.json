
{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/glm-4.7",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md",
    "docs/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "cmake --build*": "allow",
      "make*": "allow",
      "ctest*": "allow"
    }
  },
  "disabled_providers": [
    "openai",
    "google"
  ]
}
